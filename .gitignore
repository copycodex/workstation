# Состояние nvim (плагины, парсеры treesitter, бинарники mason) живёт в
# ~/.local/share/nvim и сюда не попадает — восстанавливается при первом запуске.
#
# nvim/lazy-lock.json СОЗНАТЕЛЬНО НЕ игнорируется: это лок с версиями плагинов,
# и именно он делает раскатку на второй машине воспроизводимой. Без него две
# машины разъедутся по версиям.
nvim/.netrwhist
nvim/spell/

# IDE
.idea/
.vscode/

# Мусор
*.swp
*.swo
*~
.DS_Store
.snap/
